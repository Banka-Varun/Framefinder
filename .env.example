# Vercel required: SQL database. On Sites, the DB binding is provided automatically.
TURSO_HTTP_URL=
TURSO_AUTH_TOKEN=
# Vercel image uploads: create a PRIVATE bucket. Sites uses its BUCKET binding.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=framefinder-private
# Google OAuth web client: redirect URI https://YOUR_DOMAIN/api/v1/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use real hostname-bound Turnstile keys for public hosting.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_CAPTCHA=true
# Verified sending domain for verification/reset email
RESEND_API_KEY=
MAIL_FROM=
# Broad catalog, original movie posters and country-specific watch availability
TMDB_READ_TOKEN=
# Set live-feed flag only after an authorized provider and scheduled worker are connected.
BOOKING_FEED_READY=false
BOOKING_WEBHOOK_SECRET=
# Razorpay test credentials first; webhook subscribes to payment.captured and refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALERT_PACK_PRICE_PAISE=
ALERT_PACK_CREDITS=10
# An actual issuer + marketplace payment partner implementing the documented adapter contract.
TICKET_PARTNER_URL=
TICKET_PARTNER_TOKEN=
TICKET_WEBHOOK_SECRET=
# Optional separately hosted Java + Python recommendation service
JAVA_RECOMMENDER_URL=
JAVA_RECOMMENDER_TOKEN=
# Unblocked-seat snapshots (separate from booking-open events)
SEAT_FEED_READY=false
SEAT_WEBHOOK_SECRET=

# Owner-managed, comma-separated account IDs from the accounts table. Never accept IDs submitted by visitors.
# These users sign in normally, then open /admin. No shared admin password.
ADMIN_USER_IDS=
# Browser push signing keys are generated once during db:migrate and kept server-side.
